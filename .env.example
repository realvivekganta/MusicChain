# Copy to .env and fill these locally. Never commit credentials.

# --- Model provider ----------------------------------------------------------
OPENAI_API_KEY=
SUPPORT_MODEL=openai:gpt-6-luna

# --- Hosted tracing ----------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=chinook-support-phase1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set LANGSMITH_WORKSPACE_ID if required for your workspace-scoped credentials.

# --- Local dataset -----------------------------------------------------------
# Optional override, resolved relative to the repository root.
CHINOOK_DB_PATH=src/data/chinook.sqlite

# --- Mock support cases: writable and separate from Chinook --------------------
SUPPORT_DB_PATH=src/data/support.sqlite
